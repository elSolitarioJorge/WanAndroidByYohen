<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/share_article_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="#475569" />

        <TextView
            android:id="@+id/tv_share_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="分享文章"
            android:textColor="#1E293B"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:text="分享你发现的优质 Android 技术内容"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"
            android:text="文章标题"
            android:textColor="#475569"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_article_title"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/selector_input_bg"
            android:drawableStart="@drawable/ic_text_title"
            android:drawablePadding="12dp"
            android:elevation="1dp"
            android:hint="请输入文章标题"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="#1E293B"
            android:textColorHint="#94A3B8"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="文章链接"
            android:textColor="#475569"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_article_link"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/selector_input_bg"
            android:drawableStart="@drawable/ic_link"
            android:drawablePadding="12dp"
            android:elevation="1dp"
            android:hint="例如 https://www.wanandroid.com"
            android:inputType="textUri"
            android:paddingHorizontal="16dp"
            android:textColor="#1E293B"
            android:textColorHint="#94A3B8"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:minHeight="20dp"
            android:textColor="#EF4444"
            android:textSize="13sp"
            tools:text="链接格式不正确" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/shape_btn_primary"
            android:text="提交分享"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:elevation="4dp" />

    </LinearLayout>

</ScrollView>